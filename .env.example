# FoodGO environment variables. Copy to .env (gitignored) and adjust:
#   cp .env.example .env
# Every variable is optional: the app runs with these defaults.

# HTTP port
PORT=3000

# SQLite database file (created on first start, with demo data)
FOODGO_DB=data/foodgo.db

# Time zone used for the restaurant ordering deadline
TZ=Africa/Tunis

# Show the customer's SMS code on screen (no real SMS provider yet).
# Defaults to true in development and false when NODE_ENV=production.
FOODGO_DEMO_MODE=true

# development | production | test
NODE_ENV=development

# Optional: enables the Claude-written note on the restaurant Prep forecast.
# Leave empty to use the built-in template summary. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
