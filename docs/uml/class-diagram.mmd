%% FoodGO — Class diagram (SDD §3.1, 12 domain classes) + key design classes.
%% Lab 5 revision: control classes carry the behaviour (Order and Payment are records);
%% RestaurantCustomer is an association class (Mermaid cannot draw the dashed link); forecast added (FR-31).
classDiagram
  direction LR
  class Organization {
    +organizationId: String
    +name: String
    +type: OrgType
    +status: String
    +serviceZone: ServiceZone
  }
  class Customer {
    +customerId: String
    +fullName: String
    +phoneNumber: String
    +organizationId: String
    +status: String
  }
  class RestaurantCustomer {
    <<association class>>
    +restaurantId: String
    +customerId: String
    +credentialRef: String
    +eligible: bool
    +status: String
    +registeredAt: DateTime
  }
  class Restaurant {
    +restaurantId: String
    +name: String
    +status: String
    +address: String
    +orderingDeadline: HH:MM
    +cashOnDeliveryEnabled: bool
    +ePaymentEnabled: bool
    +serviceZone: ServiceZone
  }
  class ServiceZone {
    <<enumeration>>
    LAC3_ZI_KRAM
  }
  class RestaurantStaff {
    +staffId: String
    +restaurantId: String
    +identity: String
    -credentialHash: String
  }
  class DeliveryPerson {
    +deliveryPersonId: String
    +restaurantId: String
    +identity: String
    +fullName: String
    +status: String
    -credentialHash: String
  }
  class Menu {
    +menuId: String
    +restaurantId: String
    +status: String
  }
  class MenuItem {
    +menuItemId: String
    +name: String
    +priceMillimes: int
    +available: bool
    +removed: bool
  }
  class Order {
    +orderId: FG-XXXXXX
    +status: OrderStatus
    +totalMillimes: int
    +paymentMethod: String
    +paymentStatus: String «projection»
    +serviceDate: Date
    +deadlineSnapshot: DateTime
  }
  class OrderItem {
    +quantity: int
    +unitPriceMillimes: int «snapshot»
    +nameSnapshot: String
    +lineTotal() int
  }
  class Payment {
    +paymentId: String
    +method: String
    +status: PaymentStatus
    +providerReference: String
    +amountMillimes: int
  }
  class DeliveryAssignment {
    +assignmentId: String
    +status: ASSIGNED|STARTED|COMPLETED
    +assignedAt: DateTime
    +startedAt: DateTime
    +completedAt: DateTime
  }
  class OrderManagement {
    <<control>>
    +submitOrder(principal, cart) Order
    +startPreparation(principal, restaurantId, orderId) Order
    +applyTransition(order, to, guardCtx) Order
  }
  class PaymentComponent {
    <<control>>
    +resolveStrategy(method) PaymentMethodStrategy
    +recordAtCheckout(order) status
    +recordAtDelivery(order, cashCollected) status
  }
  class NotificationComponent {
    <<Subject>>
    +publish(type, event)
    +subscribe(listener)
    +visibleTo(principal, event) bool
  }
  class ForecastComponent {
    <<control>>
    +getForecast(principal, restaurantId) Forecast
    +buildForecast(restaurantId) Forecast
    +templateSummary(forecast) String
  }
  class LLMAdapter {
    <<Adapter>>
    +enabled: bool
    +model: String
    +complete(prompt) String
  }
  class OrderState {
    <<State table>>
    +transition(from, to, ctx) status
    +allowedNext(status) list
  }
  class PaymentMethodStrategy {
    <<interface>>
    +atCheckout(order) result
    +atDelivery(order, cashCollected) result
  }
  class CashOnDeliveryStrategy
  class EPaymentStrategy
  class PaymentAdapter {
    <<Adapter>>
    +capture(orderId, amount) reference
  }

  Organization "1" --> "0..*" Customer : employs / enrols
  Customer "1" --> "0..*" RestaurantCustomer
  RestaurantCustomer "0..*" --> "1" Restaurant
  Restaurant "1" --> "0..*" RestaurantStaff
  Restaurant "1" --> "0..*" DeliveryPerson : BR-06
  Restaurant "1" --> "1..*" Menu
  Menu "1" *-- "1..*" MenuItem
  Customer "1" --> "0..*" Order
  Restaurant "1" --> "0..*" Order
  Order "1" *-- "1..*" OrderItem
  OrderItem "0..*" --> "1" MenuItem
  Order "1" --> "1..*" Payment : I-3
  Order "1" --> "0..1" DeliveryAssignment : BR-10
  DeliveryAssignment "0..*" --> "1" DeliveryPerson : BR-08
  OrderManagement ..> OrderState : status changes via
  OrderManagement ..> Order : creates / changes (only writer, BR-14)
  OrderManagement ..> PaymentComponent : recordAtCheckout
  OrderManagement ..> NotificationComponent : publish after commit (D-08)
  PaymentComponent ..> PaymentMethodStrategy : resolved at runtime
  PaymentComponent ..> Payment : owns status (D-03)
  ForecastComponent ..> OrderItem : reads daily aggregates (no customer data)
  ForecastComponent ..> LLMAdapter : optional summary (FR-31)
  PaymentMethodStrategy <|.. CashOnDeliveryStrategy
  PaymentMethodStrategy <|.. EPaymentStrategy
  EPaymentStrategy --> PaymentAdapter
